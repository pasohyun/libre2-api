# ============================================================
# 환경변수 템플릿
# ============================================================
# 사용법:
#   1. 이 파일을 복사하여 .env 파일을 만드세요:
#        cp .env.example .env
#   2. .env 파일에 실제 값을 입력하세요
#   3. .env 파일은 절대 커밋하지 마세요! (.gitignore에 포함됨)
#
# ⚠️  CI/CD 환경에서는 이 파일 대신 GitLab Variables를 사용하세요
#     (Settings > CI/CD > Variables)
# ============================================================

# === 데이터베이스 ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# === API ===
API_KEY=
API_SECRET=

# === 앱 설정 ===
APP_ENV=development
APP_PORT=8080

# === 네이버 크롤러 (Bright Data 자체 수집) ===
# 네이버가 검색 API(shop.json) 제공을 중단해 Bright Data 주거용 프록시로 직접 수집한다.
# Bright Data 크리덴셜은 proxy.env 에 둔다 (BRIGHT_DATA_PROXY/USERNAME/PASSWORD).
# 주거용 프록시는 TLS를 중계하므로 기본 CA로는 검증이 실패한다.
# 검증을 켜려면 Bright Data 인증서를 받아 경로를 지정할 것.
BRIGHT_DATA_CA_CERT=
NAVER_BD_VERIFY_TLS=false
# 수집 파라미터 (기본값으로 충분, 튜닝 시에만 설정)
NAVER_PAGE_SIZE=100
NAVER_MAX_PAGES=20
NAVER_MAX_RETRIES=3
NAVER_REQUEST_TIMEOUT=45
NAVER_PAGE_SLEEP_SEC=0.4
# 신규 엔드포인트는 카테고리를 한글명이 아닌 ID로 준다 (혈당계 계열만 통과)
NAVER_ALLOWED_SCAT_IDS=50002066
NAVER_ALLOWED_MCAT_IDS=50000065
NAVER_MIN_UNIT_PRICE=65000
# --- fallback (차단 대응) ---
# 앞에서부터 시도, 크리덴셜 없는 백엔드는 자동으로 건너뜀
NAVER_FETCH_BACKENDS=residential,unlocker,direct
# unlocker: Bright Data 다른 존(Web Unlocker 등) 크리덴셜 — proxy.env 에 둔다
#   BRIGHT_DATA_FALLBACK_USERNAME / BRIGHT_DATA_FALLBACK_PASSWORD
#   (BRIGHT_DATA_FALLBACK_PROXY 생략 시 BRIGHT_DATA_PROXY 와 같은 호스트 사용)
# direct: 프록시 없이 직접 호출. 한국 IP 서버에서만 의미 있음 (Railway 는 false 유지)
NAVER_ALLOW_DIRECT=false
# 네이버 total 대비 수집률이 이 값 미만이면 저장하지 않고 기존 데이터 보존
NAVER_MIN_COMPLETENESS=0.9
# 전체 수집 실패 시 대기 후 처음부터 재시도 (횟수 / 대기 초)
NAVER_ROUND_RETRIES=2
NAVER_ROUND_RETRY_WAIT_SEC=300

# === 회사 서버 쿠팡 크롤러 SSH 트리거 ===
# 수동 크롤링 시 회사 서버(사내망)에서 쿠팡 크롤러를 즉시 실행하기 위한 SSH 정보
# 비밀번호는 평문이므로 절대 커밋하지 말 것
COUPANG_SSH_HOST=
COUPANG_SSH_PORT=2220
COUPANG_SSH_USER=
COUPANG_SSH_PASSWORD=
# 회사 서버 내 백엔드 작업 디렉토리 (crontab과 동일)
COUPANG_SSH_WORKDIR=/home/develop/daewoong/libre2-monitor/libre2-api
# 가상환경 파이썬 (crontab과 동일하게 .venv/bin/python)
COUPANG_SSH_PYTHON=.venv/bin/python
# 실행할 모듈 (현재 메인 쿠팡 크롤러)
COUPANG_SSH_MODULE=scripts.crawl_coupang_brand
