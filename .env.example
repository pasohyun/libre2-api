# ============================================================
# 환경변수 템플릿
# ============================================================
# 사용법:
#   1. 이 파일을 복사하여 .env 파일을 만드세요:
#        cp .env.example .env
#   2. .env 파일에 실제 값을 입력하세요
#   3. .env 파일은 절대 커밋하지 마세요! (.gitignore에 포함됨)
#
# ⚠️  CI/CD 환경에서는 이 파일 대신 GitLab Variables를 사용하세요
#     (Settings > CI/CD > Variables)
# ============================================================

# === 데이터베이스 ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# === API ===
API_KEY=
API_SECRET=

# === 앱 설정 ===
APP_ENV=development
APP_PORT=8080

# === 회사 서버 쿠팡 크롤러 SSH 트리거 ===
# 수동 크롤링 시 회사 서버(사내망)에서 쿠팡 크롤러를 즉시 실행하기 위한 SSH 정보
# 비밀번호는 평문이므로 절대 커밋하지 말 것
COUPANG_SSH_HOST=
COUPANG_SSH_PORT=2220
COUPANG_SSH_USER=
COUPANG_SSH_PASSWORD=
# 회사 서버 내 백엔드 작업 디렉토리 (crontab과 동일)
COUPANG_SSH_WORKDIR=/home/develop/daewoong/libre2-monitor/libre2-api
# 가상환경 파이썬 (crontab과 동일하게 .venv/bin/python)
COUPANG_SSH_PYTHON=.venv/bin/python
# 실행할 모듈 (현재 메인 쿠팡 크롤러)
COUPANG_SSH_MODULE=scripts.crawl_coupang_brand
